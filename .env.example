# Environment
ENVIRONMENT=local
LOG_LEVEL=INFO

# API Server
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/convo_glasses
DATABASE_URL_SYNC=postgresql://postgres:postgres@postgres:5432/convo_glasses

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=convo-glasses-documents
S3_REGION=us-east-1

# Message Queue (ElasticMQ / SQS)
SQS_ENDPOINT_URL=http://elasticmq:9324
SQS_QUEUE_URL=http://elasticmq:9324/000000000000/convo-glasses-jobs
SQS_REGION=us-east-1

# Auth
AUTH_BYPASS_ENABLED=true
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# LLM Providers (optional for M0)
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
